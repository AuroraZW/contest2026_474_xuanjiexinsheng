<template>
  <div class="page">
    <scroll class="content" scroll-y="true">
      <text class="title">首次设置</text>
      <text class="subtitle">只需体重、目标与餐段</text>

      <div class="warning" if="{{storageStatus === 'corrupt'}}">
        <text class="warning-text">检测到损坏的本地数据，只有确认重建后才会覆盖。</text>
        <div class="check-row"><input class="checkbox" type="checkbox" checked="{{rebuildConfirmed}}" onchange="confirmRebuild" /><text class="check-label">确认重建本地数据</text></div>
      </div>
      <div class="warning" if="{{storageStatus === 'unavailable'}}">
        <text class="warning-text">本地存储暂不可用，当前设置无法可靠保存，请稍后重试。</text>
      </div>

      <div class="card">
        <text class="label">体重（需主动滑动确认）</text>
        <text class="number">{{weightLabel}} kg</text>
        <slider min="25" max="250" step="1" value="{{weightValue}}" onchange="changeWeight"></slider>
      </div>

      <div class="card">
        <text class="label">每日目标</text>
        <text class="number orange">{{targetKcal}} kcal</text>
        <slider min="800" max="5000" step="50" value="{{targetKcal}}" onchange="changeTarget"></slider>
      </div>

      <div class="card">
        <text class="card-title">三个默认餐段</text>
        <div class="meal-row"><text>早餐</text><picker class="time-picker" type="time" selected="{{windows.breakfast.start}}" onchange="breakfastStart"></picker><text>—</text><picker class="time-picker" type="time" selected="{{windows.breakfast.end}}" onchange="breakfastEnd"></picker></div>
        <div class="meal-row"><text>午餐</text><picker class="time-picker" type="time" selected="{{windows.lunch.start}}" onchange="lunchStart"></picker><text>—</text><picker class="time-picker" type="time" selected="{{windows.lunch.end}}" onchange="lunchEnd"></picker></div>
        <div class="meal-row"><text>晚餐</text><picker class="time-picker" type="time" selected="{{windows.dinner.start}}" onchange="dinnerStart"></picker><text>—</text><picker class="time-picker" type="time" selected="{{windows.dinner.end}}" onchange="dinnerEnd"></picker></div>
      </div>

      <div class="card">
        <text class="notice">食衡中的热量、MET 消耗和建议均为估算，仅供生活管理参考，不构成医疗、诊断、治疗或专业营养建议。如有疾病、过敏、孕期或饮食障碍等情况，请咨询合格专业人士。</text>
        <div class="check-row"><input class="checkbox" type="checkbox" checked="{{accepted}}" onchange="changeAccepted" /><text class="check-label">我已阅读并接受</text></div>
      </div>

      <text class="error" if="{{errorMessage}}">{{errorMessage}}</text>
      <input class="primary" type="button" disabled="{{saving}}" value="{{saving ? '正在保存…' : '保存并进入食衡'}}" onclick="save" />
      <div class="bottom-space"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { FOODS } from '../../data/foods'
import { defaultMealWindows, createOnboardedState, validateState } from '../../common/state'
import { loadState, saveState } from '../../common/state-store'

const validateStoredState = state => validateState(state, FOODS)

function timeFromEvent(event) {
  const hour = Number(event.hour)
  const minute = Number(event.minute)
  return (hour < 10 ? '0' : '') + hour + ':' + (minute < 10 ? '0' : '') + minute
}

export default {
  data: {
    storageStatus: 'empty',
    weightValue: 70,
    weightLabel: '请滑动',
    weightConfirmed: false,
    targetKcal: 2000,
    windows: defaultMealWindows(),
    accepted: false,
    rebuildConfirmed: false,
    saving: false,
    errorMessage: '',
    existingState: null
  },
  onInit() {
    loadState(validateStoredState, result => {
      if (result.status === 'ok' && result.state.profile) {
        const profile = result.state.profile
        this.existingState = result.state
        this.weightValue = profile.weightKg
        this.weightLabel = String(profile.weightKg)
        this.weightConfirmed = true
        this.targetKcal = profile.dailyTargetKcal
        this.windows = profile.mealWindows
        this.accepted = true
        this.storageStatus = 'ok'
      } else if (result.status !== 'empty') {
        this.storageStatus = result.status
      }
    })
  },
  changeWeight(event) { this.weightValue = event.progress; this.weightLabel = String(event.progress); this.weightConfirmed = true },
  changeTarget(event) { this.targetKcal = event.progress },
  changeAccepted(event) { this.accepted = event.checked === true },
  confirmRebuild(event) { this.rebuildConfirmed = event.checked === true },
  setTime(meal, edge, event) {
    const next = defaultMealWindows()
    next.breakfast = { start: this.windows.breakfast.start, end: this.windows.breakfast.end }
    next.lunch = { start: this.windows.lunch.start, end: this.windows.lunch.end }
    next.dinner = { start: this.windows.dinner.start, end: this.windows.dinner.end }
    next[meal][edge] = timeFromEvent(event)
    this.windows = next
  },
  breakfastStart(event) { this.setTime('breakfast', 'start', event) },
  breakfastEnd(event) { this.setTime('breakfast', 'end', event) },
  lunchStart(event) { this.setTime('lunch', 'start', event) },
  lunchEnd(event) { this.setTime('lunch', 'end', event) },
  dinnerStart(event) { this.setTime('dinner', 'start', event) },
  dinnerEnd(event) { this.setTime('dinner', 'end', event) },
  save() {
    if (this.saving) return
    this.errorMessage = ''
    if (!this.weightConfirmed) { this.errorMessage = '请主动滑动体重滑杆完成确认'; return }
    if (!this.accepted) { this.errorMessage = '请阅读并接受免责声明'; return }
    if (this.storageStatus === 'corrupt' && !this.rebuildConfirmed) { this.errorMessage = '请先明确确认重建损坏数据'; return }
    if (this.storageStatus === 'unavailable') { this.errorMessage = '本地存储不可用，暂时无法保存'; return }
    const fresh = createOnboardedState(this.weightValue, this.targetKcal, this.windows, Date.now())
    if (!fresh) { this.errorMessage = '请检查体重、目标和餐段起止时间'; return }
    const state = this.existingState || fresh
    state.profile = fresh.profile
    state.lastMaintenanceAt = fresh.lastMaintenanceAt
    this.saving = true
    saveState(validateStoredState, state, result => {
      this.saving = false
      if (result.status === 'ok') router.replace({ uri: '/pages/home' })
      else this.errorMessage = '保存或读取回验失败，输入仍已保留，请重试'
    })
  }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #101311; flex-direction: column; }
.content { width: 100%; height: 100%; flex-direction: column; padding: 42px 34px 28px 34px; }
.title { color: #f5f4ed; font-size: 42px; font-weight: bold; text-align: center; }
.subtitle { color: #aeb8b1; font-size: 21px; text-align: center; margin: 8px 0 20px 0; }
.card, .warning { width: 100%; flex-direction: column; background-color: #1d231f; border-radius: 24px; padding: 20px; margin-bottom: 16px; }
.warning { background-color: #43291d; }
.warning-text, .error { color: #ffc18a; font-size: 20px; line-height: 28px; }
.label, .card-title { color: #d9ded9; font-size: 22px; }
.card-title { font-weight: bold; margin-bottom: 12px; }
.number { color: #79d69a; font-size: 38px; font-weight: bold; margin: 8px 0; }
.orange { color: #ff9d45; }
.meal-row { width: 100%; align-items: center; justify-content: space-between; color: #f5f4ed; font-size: 20px; margin: 8px 0; }
.time-picker { width: 112px; height: 54px; color: #f5f4ed; font-size: 20px; }
.check-row { width: 100%; align-items: center; margin-top: 10px; }
.checkbox { width: 40px; height: 40px; }
.check-label { color: #d9ded9; font-size: 20px; margin-left: 10px; }
.notice { color: #c3cbc5; font-size: 18px; line-height: 27px; margin-bottom: 12px; }
.error { text-align: center; margin: 5px 0 12px 0; }
.primary { width: 100%; height: 64px; border-radius: 32px; background-color: #f28a32; color: #17120e; font-size: 24px; font-weight: bold; }
.bottom-space { height: 36px; }
</style>
