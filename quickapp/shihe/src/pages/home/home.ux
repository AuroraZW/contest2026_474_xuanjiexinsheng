<template><div class="page"><scroll class="content" scroll-y="true">
<text class="title">食衡 · 今日</text><text class="status" if="{{message}}">{{message}}</text>
<div class="capsule expanded" if="{{capsuleVisibility === 'expanded'}}"><text class="capsule-title">{{capsuleMealLabel}}时间到了</text><text class="capsule-copy">要记录这一餐吗？</text><div class="capsule-actions"><input class="capsule-button record-button" type="button" value="现在记录" onclick="newMeal"/><input class="capsule-button" type="button" value="稍后提醒" onclick="remindLater"/><input class="capsule-button" type="button" value="本餐跳过" onclick="skipMeal"/></div></div>
<div class="capsule collapsed" if="{{capsuleVisibility === 'collapsed'}}"><text class="capsule-title" if="{{capsuleStatus === 'completed'}}">{{capsuleMealLabel}}已完成 · {{capsuleKcal}} kcal</text><text class="capsule-title" if="{{capsuleStatus === 'later'}}">{{capsuleMealLabel}} · 已稍后提醒</text><text class="capsule-copy" if="{{capsuleStatus === 'later'}}">15 分钟后，下次打开或回到应用时提醒</text><text class="capsule-title" if="{{capsuleStatus === 'skipped'}}">{{capsuleMealLabel}} · 本餐已跳过</text></div>
<div class="hero" if="{{profile}}"><text class="eyebrow">今日能量 · 估算</text><div class="energy-grid"><div class="energy-cell"><text class="energy-value">{{intakeKcal}}</text><text class="energy-label">摄入 kcal</text></div><div class="energy-cell"><text class="energy-value green">{{exerciseKcal}}</text><text class="energy-label">补录消耗 kcal</text></div><div class="energy-cell"><text class="energy-value">{{netKcal}}</text><text class="energy-label">净摄入 kcal</text></div><div class="energy-cell"><text class="energy-value {{remainingExceeded ? 'orange' : 'green'}}">{{remainingDisplay}}</text><text class="energy-label">{{remainingLabel}} kcal</text></div></div><div class="segments"><text class="segment {{breakfastDone ? 'done' : ''}}">早餐 {{breakfastDone ? '完成' : '待记'}}</text><text class="segment {{lunchDone ? 'done' : ''}}">午餐 {{lunchDone ? '完成' : '待记'}}</text><text class="segment {{dinnerDone ? 'done' : ''}}">晚餐 {{dinnerDone ? '完成' : '待记'}}</text></div></div>
<input class="primary" type="button" value="＋ 记录一餐" onclick="newMeal"/><div class="card"><text class="card-title">已保存餐食</text><text class="empty" if="{{!records.length}}">今天还没有餐食记录</text><div class="record" for="(index, record) in records"><div class="record-main"><text class="record-name">{{record.mealLabel}} · {{record.itemLabel}}</text><text class="kcal">{{record.totalKcalSnapshot}} kcal</text></div><div class="actions" if="{{deleteId !== record.id}}"><input class="small" type="button" value="编辑" onclick="editMeal(record)"/><input class="small danger" type="button" value="删除" onclick="askDelete(record)"/></div><div class="confirm-delete" if="{{deleteId === record.id}}"><text class="warn">确定删除？</text><input class="tiny" type="button" value="取消" onclick="cancelDelete"/><input class="tiny danger" type="button" value="确认" onclick="confirmDelete"/></div></div></div>
<div class="card advice-card"><text class="card-title">今日小建议</text><text class="advice-copy">{{localAdvice}}</text><text class="source-note">本地规则生成 · 仅供生活管理参考</text></div>
<div class="card health-card"><div class="health-heading"><text class="card-title">service.health</text></div><div class="health-grid"><div class="health-cell"><text class="health-value">{{heartRateText}}</text><text class="health-label">心率 bpm</text></div><div class="health-cell"><text class="health-value green">{{spo2Text}}</text><text class="health-label">血氧 %</text></div><div class="health-cell"><text class="health-value orange">{{stressText}}</text><text class="health-label">压力值</text></div></div><text class="source-note">来自系统健康接口；比赛模拟器中为官方 Mock</text><text class="source-note">仅展示，不用于热量计算或诊断</text></div>
<text class="disclaimer">热量与补录运动消耗均为估算，仅供生活管理参考</text><div class="nav-row"><input class="nav-button" type="button" value="补录运动" onclick="exercise"/><input class="nav-button" type="button" value="7 天趋势" onclick="history"/></div><input class="secondary" type="button" value="修改首次设置" onclick="settings"/><div class="bottom-space"></div>
</scroll></div></template>
<script>
import router from '@system.router'
import { FOODS, calculateFoodKcal } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState, saveState } from '../../common/state-store'
import { localDateOf, todaySummary, deleteMeal, draftFromRecord, syncMealPromptState, serializeMealDraft, mealCapsuleView, setActiveMealLater, skipActiveMeal } from '../../common/meal-domain'
import { dailyEnergySummary, retainRecentLocalDays } from '../../common/energy-domain'
import { deterministicLocalAdvice, healthStateText } from '../../common/health-advice'
import { subscribeAllHealth, unsubscribeAllHealth } from '../../services/health-service'
const validateStoredState = state => validateState(state, FOODS)
const LABELS = { breakfast: '早餐', lunch: '午餐', dinner: '晚餐', snack: '加餐' }
export default { data: { state:null,profile:null,records:[],intakeKcal:0,exerciseKcal:0,netKcal:0,remainingKcal:0,remainingDisplay:0,remainingLabel:'剩余目标',remainingExceeded:false,breakfastDone:false,lunchDone:false,dinnerDone:false,capsuleVisibility:'hidden',capsuleStatus:'',capsuleMealLabel:'',capsuleKcal:0,deleteId:'',message:'',heartRateText:'读取中',spo2Text:'读取中',stressText:'读取中',stressValue:null,localAdvice:'今天还没有记录餐食，记下第一餐后建议会随记录更新。',healthActive:false,healthSession:0 },
onShow(){this.refreshToday();this.startHealth()}, onHide(){this.stopHealth()}, onDestroy(){this.stopHealth()},
startHealth(){this.stopHealth();this.healthActive=true;const session=++this.healthSession;this.heartRateText='读取中';this.spo2Text='读取中';this.stressText='读取中';this.stressValue=null;this.recomputeAdvice();let capability=true;if(typeof this.$canIUse==='function'){try{capability=this.$canIUse('@service.health')}catch(error){capability=true}}if(capability===false){this.applyHealthState('heartRate',{status:'unsupported',reason:'capability-check'});this.applyHealthState('spo2',{status:'unsupported',reason:'capability-check'});this.applyHealthState('stress',{status:'unsupported',reason:'capability-check'});return}subscribeAllHealth((kind,sample)=>{if(!this.healthActive||session!==this.healthSession)return;this.applyHealthSample(kind,sample)},(kind,state)=>{if(!this.healthActive||session!==this.healthSession)return;this.applyHealthState(kind,state)})},
stopHealth(){this.healthActive=false;this.healthSession+=1;unsubscribeAllHealth()},
applyHealthSample(kind,sample){if(kind==='heartRate')this.heartRateText=String(sample.value);else if(kind==='spo2')this.spo2Text=String(sample.value);else if(kind==='stress'){this.stressText=String(sample.value);this.stressValue=sample.value;this.recomputeAdvice()}},
applyHealthState(kind,state){const message=healthStateText(state);if(kind==='heartRate')this.heartRateText=message;else if(kind==='spo2')this.spo2Text=message;else if(kind==='stress'){this.stressText=message;this.stressValue=null;this.recomputeAdvice()}},
refreshToday(){const now=Date.now();loadState(validateStoredState,result=>{if(result.status!=='ok'||!result.state.profile){this.clearPage();this.message=result.status==='corrupt'?'本地数据损坏，未作覆盖':'无法读取本机记录';return}const original=result.state;const maintenance=retainRecentLocalDays(original,now);if(!maintenance.changed){this.renderState(original,now,'');return}saveState(validateStoredState,maintenance.state,saved=>{if(saved.status==='ok')this.renderState(maintenance.state,now,'');else this.renderState(original,now,'记录维护保存失败，已显示原有数据')})})},
clearPage(){this.state=null;this.profile=null;this.records=[];this.intakeKcal=0;this.exerciseKcal=0;this.netKcal=0;this.remainingKcal=0;this.remainingDisplay=0;this.remainingLabel='剩余目标';this.remainingExceeded=false;this.breakfastDone=false;this.lunchDone=false;this.dinnerDone=false;this.capsuleVisibility='hidden';this.capsuleStatus='';this.capsuleMealLabel='';this.capsuleKcal=0;this.deleteId='';this.recomputeAdvice()},
renderState(state,now,message){this.state=state;this.profile=state.profile;const date=localDateOf(now);const summary=todaySummary(state.meals,date);const energy=dailyEnergySummary(state.meals,state.exercises,date,state.profile.dailyTargetKcal);this.intakeKcal=energy.intakeKcal;this.exerciseKcal=energy.exerciseKcal;this.netKcal=energy.netKcal;this.remainingKcal=energy.remainingKcal;this.remainingExceeded=energy.remainingKcal<0;this.remainingDisplay=this.remainingExceeded?Math.abs(energy.remainingKcal):energy.remainingKcal;this.remainingLabel=this.remainingExceeded?'超出目标':'剩余目标';this.breakfastDone=summary.status.breakfast==='completed';this.lunchDone=summary.status.lunch==='completed';this.dinnerDone=summary.status.dinner==='completed';this.records=summary.records.map(record=>Object.assign({},record,{mealLabel:LABELS[record.mealType],itemLabel:record.items.map(item=>item.nameSnapshot).join('、')}));const capsule=mealCapsuleView(state.profile,state.meals,state.mealPromptState,now);this.capsuleVisibility=capsule.visibility;this.capsuleStatus=capsule.status||'';this.capsuleMealLabel=capsule.mealType?LABELS[capsule.mealType]:'';this.capsuleKcal=capsule.kcal||0;this.message=message;this.recomputeAdvice()},
recomputeAdvice(){this.localAdvice=deterministicLocalAdvice({stress:this.stressValue,remainingKcal:this.remainingKcal,meals:this.records,foods:FOODS})},
newMeal(){router.push({uri:'/pages/meal'})}, editMeal(record){const draftJson=serializeMealDraft(draftFromRecord(FOODS,calculateFoodKcal,record));router.push({uri:'/pages/confirm',params:{draftJson}})}, askDelete(record){this.deleteId=record.id}, cancelDelete(){this.deleteId=''}, confirmDelete(){if(!this.state||!this.deleteId)return;const now=Date.now();const meals=deleteMeal(this.state.meals,this.deleteId);const state=Object.assign({},this.state,{meals,lastMaintenanceAt:now,mealPromptState:syncMealPromptState(this.state.mealPromptState,meals,localDateOf(now))});saveState(validateStoredState,state,result=>{if(result.status==='ok'){this.deleteId='';this.renderState(state,now,'')}else this.message='删除保存失败，请重试'})},
remindLater(){this.updatePrompt(setActiveMealLater)}, skipMeal(){this.updatePrompt(skipActiveMeal)}, updatePrompt(action){if(!this.state||!this.profile)return;const now=Date.now();const update=action(this.profile,this.state.meals,this.state.mealPromptState,now);if(!update.changed){this.message='当前无法更新餐时提示';return}const state=Object.assign({},this.state,{mealPromptState:update.promptState,lastMaintenanceAt:now});saveState(validateStoredState,state,result=>{if(result.status==='ok')this.renderState(state,now,'');else this.message='餐时提示保存失败，请重试'})}, exercise(){router.push({uri:'/pages/exercise'})}, history(){router.push({uri:'/pages/history'})}, settings(){router.replace({uri:'/pages/onboarding'})} }
</script>
<style>
.page{width:100%;height:100%;background-color:#101311;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:30px 28px 24px}.title{color:#f5f4ed;font-size:36px;font-weight:bold;text-align:center;margin-bottom:12px}.status,.warn{color:#ffc18a;font-size:18px;text-align:center;margin-bottom:8px}.capsule,.hero,.card{width:100%;flex-direction:column;background-color:#1d231f;border-radius:24px;padding:18px;margin-bottom:14px}.capsule{border-width:2px;border-color:#3b4a40}.expanded{border-color:#f28a32}.collapsed{padding:16px 18px}.capsule-title{color:#f5f4ed;font-size:21px;font-weight:bold}.capsule-copy{color:#aeb8b1;font-size:16px;margin-top:4px}.capsule-actions{width:100%;justify-content:space-between;margin-top:13px}.capsule-button{width:30%;height:48px;border-radius:24px;background-color:#334039;color:#f5f4ed;font-size:17px}.record-button{background-color:#f28a32;color:#17120e}.hero{align-items:center}.eyebrow{color:#ff9d45;font-size:19px;margin-bottom:12px}.energy-grid{width:100%;flex-wrap:wrap}.energy-cell{width:50%;flex-direction:column;align-items:center;padding:8px 3px}.energy-value{color:#f5f4ed;font-size:32px;font-weight:bold}.energy-label{color:#aeb8b1;font-size:15px;text-align:center}.green{color:#79d69a}.orange{color:#ff9d45}.segments{width:100%;justify-content:space-between;margin-top:13px}.segment{color:#ffae68;font-size:15px}.done{color:#79d69a}.primary,.secondary{width:100%;height:58px;border-radius:29px;background-color:#f28a32;color:#17120e;font-size:22px;font-weight:bold;margin-bottom:14px}.secondary{background-color:#27312b;color:#dce3dd}.nav-row{width:100%;justify-content:space-between;margin-bottom:14px}.nav-button{width:48%;height:54px;border-radius:27px;background-color:#294436;color:#79d69a;font-size:20px;font-weight:bold}.card-title{color:#f5f4ed;font-size:22px;font-weight:bold;margin-bottom:9px}.empty,.disclaimer{color:#aeb8b1;font-size:17px;text-align:center}.record{width:100%;flex-direction:column;border-top-width:1px;border-color:#39423c;padding:11px 0}.record-main{width:100%;justify-content:space-between}.record-name{color:#f5f4ed;font-size:17px;width:66%}.kcal{color:#ff9d45;font-size:17px}.actions,.confirm-delete{width:100%;justify-content:flex-end;align-items:center;margin-top:8px}.small,.tiny{width:88px;height:42px;border-radius:21px;background-color:#334039;color:#f5f4ed;font-size:17px;margin-left:8px}.tiny{width:70px}.danger{background-color:#6d332d;color:#ffd8d0}.advice-card{border-width:2px;border-color:#73502f}.advice-copy{color:#f5f4ed;font-size:18px;line-height:26px}.source-note{color:#8f9c94;font-size:14px;margin-top:8px}.health-heading{width:100%;justify-content:space-between;align-items:center}.mock-label{color:#ff9d45;font-size:14px}.health-grid{width:100%;justify-content:space-between}.health-cell{width:32%;flex-direction:column;align-items:center}.health-value{color:#f5f4ed;font-size:20px;font-weight:bold;text-align:center}.health-label{color:#aeb8b1;font-size:14px;text-align:center;margin-top:4px}.disclaimer{margin:3px 0 13px}.bottom-space{height:36px}
</style>
