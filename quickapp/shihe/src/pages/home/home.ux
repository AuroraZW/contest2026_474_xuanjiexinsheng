<template><div class="page"><scroll class="content" scroll-y="true">
<text class="title">食衡 · 今日</text><text class="status" if="{{message}}">{{message}}</text>
<div class="hero" if="{{profile}}"><text class="eyebrow">今日摄入 · 估算</text><text class="big">{{totalKcal}}</text><text class="unit">kcal / 目标 {{profile.dailyTargetKcal}}</text><div class="segments"><text class="segment {{breakfastDone ? 'done' : ''}}">早餐 {{breakfastDone ? '完成' : '待记'}}</text><text class="segment {{lunchDone ? 'done' : ''}}">午餐 {{lunchDone ? '完成' : '待记'}}</text><text class="segment {{dinnerDone ? 'done' : ''}}">晚餐 {{dinnerDone ? '完成' : '待记'}}</text></div></div>
<input class="primary" type="button" value="＋ 记录一餐" onclick="newMeal"/><div class="card"><text class="card-title">已保存餐食</text><text class="empty" if="{{!records.length}}">今天还没有餐食记录</text><div class="record" for="(index, record) in records"><div class="record-main"><text class="record-name">{{record.mealLabel}} · {{record.itemLabel}}</text><text class="kcal">{{record.totalKcalSnapshot}} kcal</text></div><div class="actions" if="{{deleteId !== record.id}}"><input class="small" type="button" value="编辑" onclick="editMeal(record)"/><input class="small danger" type="button" value="删除" onclick="askDelete(record)"/></div><div class="confirm-delete" if="{{deleteId === record.id}}"><text class="warn">确定删除？</text><input class="tiny" type="button" value="取消" onclick="cancelDelete"/><input class="tiny danger" type="button" value="确认" onclick="confirmDelete"/></div></div></div>
<text class="disclaimer">热量为估算，仅供生活管理参考</text><input class="secondary" type="button" value="修改首次设置" onclick="settings"/><div class="bottom-space"></div>
</scroll></div></template>
<script>
import router from '@system.router'
import { FOODS, calculateFoodKcal } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState, saveState } from '../../common/state-store'
import { localDateOf, todaySummary, deleteMeal, draftFromRecord, syncMealPromptState, serializeMealDraft } from '../../common/meal-domain'
const validateStoredState = state => validateState(state, FOODS)
const LABELS = { breakfast: '早餐', lunch: '午餐', dinner: '晚餐', snack: '加餐' }
export default { data: { state:null,profile:null,records:[],totalKcal:0,breakfastDone:false,lunchDone:false,dinnerDone:false,deleteId:'',message:'' },
onShow(){this.refreshToday()}, refreshToday(){ loadState(validateStoredState,result=>{ if(result.status!=='ok'||!result.state.profile){this.state=null;this.profile=null;this.records=[];this.totalKcal=0;this.breakfastDone=false;this.lunchDone=false;this.dinnerDone=false;this.message=result.status==='corrupt'?'本地数据损坏，未作覆盖':'无法读取本机记录';return} this.state=result.state;this.profile=result.state.profile;const summary=todaySummary(result.state.meals,localDateOf(Date.now()));this.totalKcal=summary.totalKcal;this.breakfastDone=summary.status.breakfast==='completed';this.lunchDone=summary.status.lunch==='completed';this.dinnerDone=summary.status.dinner==='completed';this.records=summary.records.map(record=>Object.assign({},record,{mealLabel:LABELS[record.mealType],itemLabel:record.items.map(item=>item.nameSnapshot).join('、')}));this.message='' }) },
newMeal(){router.push({uri:'/pages/meal'})}, editMeal(record){const draftJson=serializeMealDraft(draftFromRecord(FOODS,calculateFoodKcal,record));router.push({uri:'/pages/confirm',params:{draftJson}})}, askDelete(record){this.deleteId=record.id}, cancelDelete(){this.deleteId=''}, confirmDelete(){if(!this.state||!this.deleteId)return;const meals=deleteMeal(this.state.meals,this.deleteId);const date=localDateOf(Date.now());const state=Object.assign({},this.state,{meals,lastMaintenanceAt:Date.now(),mealPromptState:syncMealPromptState(this.state.mealPromptState,meals,date)});saveState(validateStoredState,state,result=>{if(result.status==='ok'){this.deleteId='';this.refreshToday()}else this.message='删除保存失败，请重试'})}, settings(){router.replace({uri:'/pages/onboarding'})} }
</script>
<style>
.page{width:100%;height:100%;background-color:#101311;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:38px 34px 28px}.title{color:#f5f4ed;font-size:39px;font-weight:bold;text-align:center;margin-bottom:14px}.status,.warn{color:#ffc18a;font-size:19px;text-align:center}.hero,.card{width:100%;flex-direction:column;background-color:#1d231f;border-radius:26px;padding:20px;margin-bottom:16px}.hero{align-items:center}.eyebrow{color:#ff9d45;font-size:20px}.big{color:#f5f4ed;font-size:62px;font-weight:bold}.unit,.empty,.disclaimer{color:#aeb8b1;font-size:18px;text-align:center}.segments{width:100%;justify-content:space-between;margin-top:15px}.segment{color:#ffae68;font-size:16px}.done{color:#79d69a}.primary,.secondary{width:100%;height:62px;border-radius:31px;background-color:#f28a32;color:#17120e;font-size:23px;font-weight:bold;margin-bottom:16px}.secondary{background-color:#27312b;color:#dce3dd}.card-title{color:#f5f4ed;font-size:23px;font-weight:bold;margin-bottom:10px}.record{width:100%;flex-direction:column;border-top-width:1px;border-color:#39423c;padding:12px 0}.record-main{width:100%;justify-content:space-between}.record-name{color:#f5f4ed;font-size:18px;width:68%}.kcal{color:#ff9d45;font-size:18px}.actions,.confirm-delete{width:100%;justify-content:flex-end;align-items:center;margin-top:8px}.small,.tiny{width:92px;height:44px;border-radius:22px;background-color:#334039;color:#f5f4ed;font-size:18px;margin-left:8px}.tiny{width:72px}.danger{background-color:#6d332d;color:#ffd8d0}.disclaimer{margin:3px 0 14px}.bottom-space{height:40px}
</style>
