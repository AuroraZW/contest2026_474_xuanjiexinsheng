<template><div class="page"><scroll class="content" scroll-y="true">
<text class="title">运动补录</text><text class="status" if="{{message}}">{{message}}</text><text class="source-note">手动补录 · MET 估算</text>
<div class="card" if="{{profile}}"><text class="label">运动类型</text><picker class="picker" type="text" range="{{activityNames}}" selected="{{activityIndex}}" onchange="changeActivity"></picker><text class="label">时长 · {{duration}} 分钟</text><slider min="5" max="180" step="5" value="{{duration}}" onchange="changeDuration"></slider><div class="duration-row"><input class="round" type="button" value="− 5" onclick="minusDuration"/><input class="round" type="button" value="＋ 5" onclick="plusDuration"/></div><div class="estimate"><text class="estimate-label">补录消耗 · 估算</text><text class="estimate-value">{{estimatedKcal}} kcal</text></div><input class="primary" type="button" disabled="{{saving}}" value="{{saving ? '正在保存并回验…' : (editId ? '保存补录修改' : '保存补录')}}" onclick="save"/><input class="secondary" if="{{editId}}" type="button" value="取消编辑" onclick="cancelEdit"/></div>
<div class="card"><text class="card-title">今日补录消耗 {{todayTotal}} kcal</text><text class="empty" if="{{!records.length}}">今天还没有补录运动</text><div class="record" for="(index, record) in records"><div class="record-main"><text class="record-name">{{record.activityName}} · {{record.durationMinutes}} 分钟</text><text class="kcal">{{record.kcalSnapshot}} kcal</text></div><div class="actions" if="{{deleteId !== record.id}}"><input class="small" type="button" value="编辑" onclick="startEdit(record)"/><input class="small danger" type="button" value="删除" onclick="askDelete(record)"/></div><div class="confirm" if="{{deleteId === record.id}}"><text class="warn">确定删除这条补录？</text><input class="tiny" type="button" value="取消" onclick="cancelDelete"/><input class="tiny danger" type="button" value="确认" onclick="confirmDelete"/></div></div></div>
<text class="disclaimer">运动消耗按 MET、体重与时长估算，仅供生活管理参考，不构成医疗或专业建议。</text><input class="back" type="button" value="返回" onclick="back"/><div class="bottom-space"></div>
</scroll></div></template>
<script>
import router from '@system.router'
import { FOODS } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState, saveState } from '../../common/state-store'
import { EXERCISE_ACTIVITIES, localDateOf, calculateExerciseKcal, createExerciseRecord, editExerciseRecord, upsertExercise, deleteExercise } from '../../common/energy-domain'
const validateStoredState=state=>validateState(state,FOODS)
export default {data:{state:null,profile:null,activityNames:EXERCISE_ACTIVITIES.map(item=>item.name),activityIndex:0,duration:30,estimatedKcal:0,records:[],todayTotal:0,editId:'',editingRecord:null,deleteId:'',saving:false,message:''},
onShow(){this.loadToday()},loadToday(){loadState(validateStoredState,result=>{if(result.status!=='ok'||!result.state.profile){this.state=null;this.profile=null;this.records=[];this.todayTotal=0;this.estimatedKcal=0;this.message=result.status==='corrupt'?'本地数据损坏，未作覆盖':'无法读取本机记录';return}this.renderState(result.state,'')})},renderState(state,message){this.state=state;this.profile=state.profile;const today=localDateOf(Date.now());this.records=state.exercises.filter(record=>record.localDate===today).map(record=>Object.assign({},record,{activityName:(EXERCISE_ACTIVITIES.find(item=>item.id===record.activity)||{name:record.activity}).name}));this.todayTotal=this.records.reduce((sum,record)=>sum+record.kcalSnapshot,0);this.message=message;this.recalculate()},recalculate(){if(!this.profile)return;const selected=EXERCISE_ACTIVITIES[this.activityIndex];this.estimatedKcal=calculateExerciseKcal(selected.met,this.profile.weightKg,this.duration)},changeActivity(event){this.activityIndex=event.newSelected;this.recalculate()},changeDuration(event){this.duration=event.progress;this.recalculate()},minusDuration(){this.duration=Math.max(5,this.duration-5);this.recalculate()},plusDuration(){this.duration=Math.min(180,this.duration+5);this.recalculate()},startEdit(record){const index=EXERCISE_ACTIVITIES.findIndex(item=>item.id===record.activity);this.activityIndex=index<0?0:index;this.duration=Math.max(5,Math.min(180,record.durationMinutes));this.editId=record.id;this.editingRecord=Object.assign({},record);this.deleteId='';this.message=record.durationMinutes===this.duration?'':'原记录时长已调整到表单范围';this.recalculate()},cancelEdit(){this.resetForm()},resetForm(){this.activityIndex=0;this.duration=30;this.editId='';this.editingRecord=null;this.deleteId='';this.recalculate()},save(){if(this.saving||!this.state||!this.profile)return;const selected=EXERCISE_ACTIVITIES[this.activityIndex];const now=Date.now();const record=this.editId?editExerciseRecord(this.editingRecord,selected.id,this.profile.weightKg,this.duration,now):createExerciseRecord(selected.id,this.profile.weightKg,this.duration,now);if(!record){this.message='运动记录无效，无法保存';return}const nextState=Object.assign({},this.state,{exercises:upsertExercise(this.state.exercises,record),lastMaintenanceAt:now});this.saving=true;saveState(validateStoredState,nextState,result=>{this.saving=false;if(result.status==='ok'){this.resetForm();this.renderState(nextState,'运动记录已保存')}else this.message='保存或读取回验失败，请重试'})},askDelete(record){this.deleteId=record.id},cancelDelete(){this.deleteId=''},confirmDelete(){if(!this.state||!this.deleteId||this.saving)return;const now=Date.now();const nextState=Object.assign({},this.state,{exercises:deleteExercise(this.state.exercises,this.deleteId),lastMaintenanceAt:now});this.saving=true;saveState(validateStoredState,nextState,result=>{this.saving=false;if(result.status==='ok'){this.resetForm();this.renderState(nextState,'运动记录已删除')}else this.message='删除保存失败，请重试'})},back(){router.back()}}
</script>
<style>
.source-note{color:#858681;font-size:14px;text-align:center;margin-bottom:12px}
.page{width:100%;height:100%;background-color:#090a09;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:28px 26px 24px}.title{color:#f4f1e8;font-size:32px;font-weight:bold;text-align:center;margin-bottom:8px}.status,.warn{color:#c7a382;font-size:17px;text-align:center;margin-bottom:9px}.card{width:100%;flex-direction:column;background-color:#1c1d1c;border-radius:24px;padding:18px;margin-bottom:14px}.label,.card-title{color:#d5d2ca;font-size:19px;font-weight:bold;margin-bottom:8px}.picker{width:100%;height:52px;color:#e5e1d8;font-size:19px;margin-bottom:13px}.duration-row,.record-main,.actions,.confirm{width:100%;justify-content:space-between;align-items:center}.round{width:47%;height:46px;border-radius:23px;background-color:#292a29;color:#d5d2ca;font-size:18px}.estimate{width:100%;align-items:center;justify-content:space-between;margin:17px 0}.estimate-label,.empty,.disclaimer{color:#858681;font-size:16px}.estimate-value,.kcal{color:#e5e1d8;font-size:22px;font-weight:bold}.primary,.secondary,.back{width:100%;height:56px;border-radius:28px;background-color:#f28a32;color:#17120e;font-size:20px;font-weight:bold;margin-top:8px}.secondary,.back{height:48px;background-color:#222322;color:#c7c4bc;font-size:17px;font-weight:normal}.record{width:100%;flex-direction:column;border-top-width:1px;border-color:#343534;padding:12px 0}.record-name{color:#e5e1d8;font-size:17px;width:68%}.actions,.confirm{justify-content:flex-end;margin-top:8px}.small,.tiny{width:88px;height:44px;border-radius:22px;background-color:#292a29;color:#d5d2ca;font-size:17px;margin-left:8px}.tiny{width:70px}.danger{background-color:#322826;color:#d9aaa2}.disclaimer{text-align:center;line-height:24px;margin:2px 0 8px}.bottom-space{height:34px}
</style>
