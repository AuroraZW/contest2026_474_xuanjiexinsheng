<template><div class="page"><scroll class="content" scroll-y="true"><text class="title">7 天趋势</text><text class="status" if="{{message}}">{{message}}</text><text class="subtitle">摄入、运动消耗与净摄入</text><div class="day {{day.isToday ? 'today' : ''}}" for="(index, day) in days"><div class="day-head"><text class="date">{{day.localDate}}</text><text class="today-label" if="{{day.isToday}}">今天</text></div><div class="metrics"><div class="metric"><text class="value orange">{{day.intakeKcal}}</text><text class="label">摄入</text></div><div class="metric"><text class="value green">{{day.exerciseKcal}}</text><text class="label">运动估算</text></div><div class="metric"><text class="value">{{day.netKcal}}</text><text class="label">净摄入</text></div></div></div><text class="disclaimer">热量与运动消耗数值均为估算，仅供生活管理参考。</text><input class="back" type="button" value="返回" onclick="back"/><div class="bottom-space"></div></scroll></div></template>
<script>
import router from '@system.router'
import { FOODS } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState } from '../../common/state-store'
import { localDateOf, sevenDayEnergyTrend } from '../../common/energy-domain'
const validateStoredState=state=>validateState(state,FOODS)
export default {data:{days:[],message:''},onShow(){loadState(validateStoredState,result=>{if(result.status!=='ok'||!result.state.profile){this.days=[];this.message=result.status==='corrupt'?'本地数据损坏，未作覆盖':'无法读取本机记录';return}const today=localDateOf(Date.now());this.days=sevenDayEnergyTrend(result.state.meals,result.state.exercises,today,result.state.profile.dailyTargetKcal).map(day=>Object.assign({},day,{isToday:day.localDate===today}));this.message=''})},back(){router.back()}}
</script>
<style>
.page{width:100%;height:100%;background-color:#101311;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:30px 28px 24px}.title{color:#f5f4ed;font-size:38px;font-weight:bold;text-align:center}.subtitle,.disclaimer{color:#aeb8b1;font-size:17px;text-align:center;margin:7px 0 14px}.status{color:#ffc18a;font-size:18px;text-align:center;margin-top:8px}.day{width:100%;flex-direction:column;background-color:#1d231f;border-radius:20px;padding:15px 17px;margin-bottom:11px;border-width:2px;border-color:#1d231f}.today{border-color:#f28a32}.day-head,.metrics{width:100%;justify-content:space-between;align-items:center}.date{color:#f5f4ed;font-size:20px;font-weight:bold}.today-label{color:#ff9d45;font-size:18px}.metrics{margin-top:10px}.metric{width:33%;flex-direction:column;align-items:center}.value{color:#f5f4ed;font-size:25px;font-weight:bold}.orange{color:#ff9d45}.green{color:#79d69a}.label{color:#aeb8b1;font-size:15px}.disclaimer{line-height:25px}.back{width:100%;height:56px;border-radius:28px;background-color:#27312b;color:#dce3dd;font-size:21px;font-weight:bold}.bottom-space{height:36px}
</style>
