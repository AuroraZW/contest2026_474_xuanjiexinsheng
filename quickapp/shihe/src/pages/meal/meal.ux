<template><div class="page"><scroll class="content" scroll-y="true">
<text class="title">记下这一餐</text>
<div class="meal-types"><input class="chip {{mealType === 'breakfast' ? 'active' : ''}}" type="button" value="早餐" onclick="chooseType('breakfast')"/><input class="chip {{mealType === 'lunch' ? 'active' : ''}}" type="button" value="午餐" onclick="chooseType('lunch')"/><input class="chip {{mealType === 'dinner' ? 'active' : ''}}" type="button" value="晚餐" onclick="chooseType('dinner')"/><input class="chip {{mealType === 'snack' ? 'active' : ''}}" type="button" value="加餐" onclick="chooseType('snack')"/></div>
<div class="mode-switch"><input class="mode {{entryMode === 'transcript' ? 'mode-active' : ''}}" type="button" value="一句话记餐" onclick="chooseMode('transcript')"/><input class="mode {{entryMode === 'quick' ? 'mode-active' : ''}}" type="button" value="快捷选择" onclick="chooseMode('quick')"/></div>
<div class="mode-content" if="{{entryMode === 'transcript'}}">
  <div class="card transcript"><text class="notice">输入你刚吃的食物和份量。初赛为模拟器转写演示，不是录音或语音识别。</text><input class="text-input" if="{{!parsed}}" type="text" maxlength="80" value="{{transcript}}" placeholder="例如：一碗米饭、一份番茄炒蛋" onchange="changeText"/><input class="example" if="{{!parsed}}" type="button" value="使用示例：米饭 + 鸡胸肉" onclick="useExample"/><input class="parse" if="{{!parsed}}" type="button" value="识别这顿饭" onclick="parseText"/><div class="parsed-result" if="{{parsed}}"><text class="source-text">原文：{{transcript}}</text><input class="example edit-text" type="button" value="修改这句话" onclick="editText"/><text class="label">识别结果</text><text class="empty" if="{{!recognized.length}}">没有识别到可记录食品</text><text class="result parsed-line" for="recognized">{{$item.name}} · {{$item.basisAmount}}{{$item.basisUnit}} · {{$item.kcal}} kcal</text><input class="ignore" if="{{!unknown.length && recognized.length}}" type="button" value="确认识别结果" onclick="goParsed"/><text class="label unknown" if="{{unknown.length}}">需要处理的内容</text><text class="warn parsed-line" for="unknown">“{{$item.text}}” · {{$item.reason}}</text><input class="ignore" if="{{unknown.length && recognized.length}}" type="button" value="忽略未识别项并确认" onclick="ignoreAndContinue"/><text class="warn" if="{{unknown.length}}">也可修改文本后重新识别；未识别内容不会被静默保存。</text></div></div>
</div>
<div class="mode-content" if="{{entryMode === 'quick'}}">
  <div class="card"><text class="card-title">最近食品</text><text class="empty" if="{{!recentFoods.length}}">保存第一餐后，这里会出现最近选择</text><div class="food-row" for="recentFoods" onclick="addRecent($item)"><text class="food-name">{{$item.name}}</text><text class="add">＋ {{$item.defaultServing.label}}</text></div></div>
  <div class="card"><text class="card-title">收藏套餐</text><text class="empty" if="{{!favorites.length}}">可在确认页收藏整餐，下次直接复用</text><div class="food-row" for="favorites" onclick="useFavorite($item)"><text class="food-name">{{$item.name}}</text><text class="add">直接去确认 ›</text></div></div>
  <div class="card"><text class="card-title">60 项食品目录</text><picker class="picker" type="text" range="{{categories}}" selected="{{categoryIndex}}" onchange="changeCategory"></picker><div class="food-row" for="catalog" onclick="addCatalog($item)"><text class="food-name">{{$item.name}}</text><text class="add">＋ {{$item.defaultServing.label}}</text></div></div>
  <div class="draft"><text class="card-title">当前已选 {{items.length}} 项</text><text class="result" for="items">{{$item.name}} · {{$item.basisAmount}}{{$item.basisUnit}}</text></div><input class="primary" type="button" disabled="{{!items.length}}" value="进入确认（{{items.length}} 项）" onclick="confirmCatalog"/>
</div>
<div class="bottom-space"></div>
</scroll></div></template>
<script>
import router from '@system.router'
import { FOODS, calculateFoodKcal } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState } from '../../common/state-store'
import { parseMealText } from '../../common/meal-text-parser'
import { inferMealType, addFoodToItems, itemFromFood, foodById, serializeMealDraft } from '../../common/meal-domain'
const validateStoredState = state => validateState(state, FOODS)
const lookupFood = foodId => foodById(FOODS, foodId)
export default { data:{state:null,mealType:'snack',entryMode:'transcript',categories:['主食','常见菜肴','蛋白质','蔬菜','水果','饮品','零食'],categoryIndex:0,catalog:[],recentFoods:[],favorites:[],items:[],transcript:'',parsed:false,recognized:[],unknown:[]},
onInit(){this.catalog=FOODS.filter(food=>food.category===this.categories[0]);loadState(validateStoredState,result=>{if(result.status!=='ok')return;this.state=result.state;this.mealType=inferMealType(result.state.profile,Date.now());this.recentFoods=result.state.recentFoodIds.map(lookupFood).filter(Boolean);this.favorites=result.state.favoriteMeals})},chooseType(type){this.mealType=type},chooseMode(mode){this.entryMode=mode},changeCategory(event){this.categoryIndex=event.newSelected;this.catalog=FOODS.filter(food=>food.category===this.categories[this.categoryIndex])},addCatalog(food){this.items=addFoodToItems(calculateFoodKcal,this.items,food);this.draftSource='catalog'},addRecent(food){this.items=addFoodToItems(calculateFoodKcal,this.items,food);this.draftSource='recent'},openConfirm(draft){router.push({uri:'/pages/confirm',params:{draftJson:serializeMealDraft(draft)}})},useFavorite(favorite){const items=favorite.items.map(item=>itemFromFood(calculateFoodKcal,lookupFood(item.foodId),item.amount));this.openConfirm({mealType:this.mealType,source:'favorite',items})},changeText(event){this.transcript=event.value},useExample(){this.transcript='米饭200克、鸡胸肉150g'},parseText(){const output=parseMealText(this.transcript,FOODS,calculateFoodKcal);this.parsed=true;this.recognized=output.recognizedItems;this.unknown=output.unknownSegments},editText(){this.parsed=false;this.recognized=[];this.unknown=[]},goParsed(){if(!this.recognized.length)return;const items=this.recognized.map(item=>itemFromFood(calculateFoodKcal,lookupFood(item.foodId),item.basisAmount));this.openConfirm({mealType:this.mealType,source:'transcript-demo',items})},ignoreAndContinue(){if(this.recognized.length&&this.unknown.length)this.goParsed()},confirmCatalog(){if(!this.items.length)return;this.openConfirm({mealType:this.mealType,source:this.draftSource||'catalog',items:this.items})} }
</script>
<style>
.page{width:100%;height:100%;background-color:#090a09;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:24px 26px 22px}.title{color:#f4f1e8;font-size:32px;font-weight:bold;text-align:center;margin-bottom:12px}.mode-content{width:100%;flex-direction:column}.card,.draft{width:100%;flex-direction:column;background-color:#1c1d1c;border-radius:24px;padding:16px;margin-bottom:12px}.card-title,.label{color:#f4f1e8;font-size:20px;font-weight:bold;margin-bottom:9px}.meal-types{width:100%;justify-content:space-between;margin-bottom:11px}.chip{width:23%;height:42px;border-radius:21px;background-color:#292a29;color:#aaa9a3;font-size:16px}.active{background-color:#35322f;color:#f4f1e8}.mode-switch{width:100%;height:46px;border-radius:23px;background-color:#1c1d1c;padding:3px;margin-bottom:11px}.mode{width:50%;height:40px;border-radius:20px;background-color:#1c1d1c;color:#858681;font-size:16px}.mode-active{background-color:#35322f;color:#f4f1e8}.empty,.notice{color:#858681;font-size:15px;line-height:22px}.notice{margin-bottom:8px}.food-row{width:100%;min-height:52px;align-items:center;justify-content:space-between;border-top-width:1px;border-color:#343534}.food-name,.result{color:#e5e1d8;font-size:17px}.add{color:#aaa9a3;font-size:15px}.picker{width:100%;height:52px;color:#e5e1d8;font-size:19px}.text-input{width:100%;height:52px;border-radius:18px;background-color:#292a29;color:#f4f1e8;font-size:17px;padding:0 14px}.example,.parse,.ignore{width:100%;height:46px;border-radius:23px;background-color:#292a29;color:#d5d2ca;font-size:16px;margin-top:8px}.parse,.ignore{background-color:#f28a32;color:#17120e}.parsed-result{width:100%;flex-direction:column}.source-text{width:100%;color:#e5e1d8;font-size:17px;line-height:25px;margin-bottom:9px}.edit-text{margin-top:0;margin-bottom:12px}.parsed-line{width:100%;line-height:25px;margin-bottom:6px}.unknown{margin-top:12px}.warn{color:#c7a382;font-size:16px;line-height:24px}.draft{background-color:#202120}.primary{width:100%;height:58px;border-radius:29px;background-color:#f28a32;color:#17120e;font-size:21px;font-weight:bold}.bottom-space{height:32px}
</style>
