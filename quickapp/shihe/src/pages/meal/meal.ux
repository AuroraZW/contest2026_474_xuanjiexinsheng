<template><div class="page"><scroll class="content" scroll-y="true">
<text class="title">记录一餐</text><div class="card"><text class="label">餐次</text><div class="meal-types"><input class="chip {{mealType === 'breakfast' ? 'active' : ''}}" type="button" value="早餐" onclick="chooseType('breakfast')"/><input class="chip {{mealType === 'lunch' ? 'active' : ''}}" type="button" value="午餐" onclick="chooseType('lunch')"/><input class="chip {{mealType === 'dinner' ? 'active' : ''}}" type="button" value="晚餐" onclick="chooseType('dinner')"/><input class="chip {{mealType === 'snack' ? 'active' : ''}}" type="button" value="加餐" onclick="chooseType('snack')"/></div></div>
<div class="card"><text class="card-title">最近食品</text><text class="empty" if="{{!recentFoods.length}}">暂无最近食品，保存首餐后会出现</text><div class="food-row" for="recentFoods" onclick="addRecent($item)"><text class="food-name">{{$item.name}}</text><text class="add">＋ {{$item.defaultServing.label}}</text></div></div>
<div class="card"><text class="card-title">收藏套餐</text><text class="empty" if="{{!favorites.length}}">暂无收藏套餐，可在确认页收藏整餐</text><div class="food-row" for="favorites" onclick="useFavorite($item)"><text class="food-name">{{$item.name}}</text><text class="add">直接去确认 ›</text></div></div>
<div class="card"><text class="card-title">60 项食品目录</text><picker class="picker" type="text" range="{{categories}}" selected="{{categoryIndex}}" onchange="changeCategory"></picker><div class="food-row" for="catalog" onclick="addCatalog($item)"><text class="food-name">{{$item.name}}</text><text class="add">＋ {{$item.defaultServing.label}}</text></div></div>
<div class="card transcript"><text class="card-title">一句话记餐（模拟器转写模式）</text><text class="notice">这里只是键入/选择的转写文本，不是录音或语音识别。</text><input class="text-input" if="{{!parsed}}" type="text" maxlength="80" value="{{transcript}}" placeholder="最多 80 字" onchange="changeText"/><input class="example" if="{{!parsed}}" type="button" value="计划示例：米饭 + 鸡胸肉" onclick="useExample"/><input class="parse" if="{{!parsed}}" type="button" value="解析文本" onclick="parseText"/><div class="parsed-result" if="{{parsed}}"><text class="source-text">原文：{{transcript}}</text><input class="example edit-text" type="button" value="修改文本" onclick="editText"/><text class="label">识别项</text><text class="empty" if="{{!recognized.length}}">没有识别到可记录食品</text><text class="result parsed-line" for="recognized">{{$item.name}} · {{$item.basisAmount}}{{$item.basisUnit}} · {{$item.kcal}} kcal</text><input class="ignore" if="{{!unknown.length && recognized.length}}" type="button" value="使用识别项进入确认" onclick="goParsed"/><text class="label unknown" if="{{unknown.length}}">全部未识别片段</text><text class="warn parsed-line" for="unknown">“{{$item.text}}” · {{$item.reason}}</text><input class="ignore" if="{{unknown.length && recognized.length}}" type="button" value="忽略未识别项并继续" onclick="ignoreAndContinue"/><text class="warn" if="{{unknown.length}}">也可修改文本后重新解析；未识别项不会被静默保存。</text></div></div>
<div class="draft"><text class="card-title">当前草稿 {{items.length}} 项</text><text class="result" for="items">{{$item.name}} · {{$item.basisAmount}}{{$item.basisUnit}}</text></div><input class="primary" type="button" disabled="{{!items.length}}" value="进入确认（{{items.length}} 项）" onclick="confirmCatalog"/><div class="bottom-space"></div>
</scroll></div></template>
<script>
import router from '@system.router'
import { FOODS, calculateFoodKcal } from '../../data/foods'
import { validateState } from '../../common/state'
import { loadState } from '../../common/state-store'
import { parseMealText } from '../../common/meal-text-parser'
import { inferMealType, addFoodToItems, itemFromFood, foodById, serializeMealDraft } from '../../common/meal-domain'
const validateStoredState = state => validateState(state, FOODS)
const lookupFood = foodId => foodById(FOODS, foodId)
export default { data:{state:null,mealType:'snack',categories:['主食','常见菜肴','蛋白质','蔬菜','水果','饮品','零食'],categoryIndex:0,catalog:[],recentFoods:[],favorites:[],items:[],transcript:'',parsed:false,recognized:[],unknown:[]},
onInit(){this.catalog=FOODS.filter(food=>food.category===this.categories[0]);loadState(validateStoredState,result=>{if(result.status!=='ok')return;this.state=result.state;this.mealType=inferMealType(result.state.profile,Date.now());this.recentFoods=result.state.recentFoodIds.map(lookupFood).filter(Boolean);this.favorites=result.state.favoriteMeals})},chooseType(type){this.mealType=type},changeCategory(event){this.categoryIndex=event.newSelected;this.catalog=FOODS.filter(food=>food.category===this.categories[this.categoryIndex])},addCatalog(food){this.items=addFoodToItems(calculateFoodKcal,this.items,food);this.draftSource='catalog'},addRecent(food){this.items=addFoodToItems(calculateFoodKcal,this.items,food);this.draftSource='recent'},openConfirm(draft){router.push({uri:'/pages/confirm',params:{draftJson:serializeMealDraft(draft)}})},useFavorite(favorite){const items=favorite.items.map(item=>itemFromFood(calculateFoodKcal,lookupFood(item.foodId),item.amount));this.openConfirm({mealType:this.mealType,source:'favorite',items})},changeText(event){this.transcript=event.value},useExample(){this.transcript='米饭200克、鸡胸肉150g'},parseText(){const output=parseMealText(this.transcript,FOODS,calculateFoodKcal);this.parsed=true;this.recognized=output.recognizedItems;this.unknown=output.unknownSegments},editText(){this.parsed=false;this.recognized=[];this.unknown=[]},goParsed(){if(!this.recognized.length)return;const items=this.recognized.map(item=>itemFromFood(calculateFoodKcal,lookupFood(item.foodId),item.basisAmount));this.openConfirm({mealType:this.mealType,source:'transcript-demo',items})},ignoreAndContinue(){if(this.recognized.length&&this.unknown.length)this.goParsed()},confirmCatalog(){if(!this.items.length)return;this.openConfirm({mealType:this.mealType,source:this.draftSource||'catalog',items:this.items})} }
</script>
<style>
.page{width:100%;height:100%;background-color:#101311;flex-direction:column}.content{width:100%;height:100%;flex-direction:column;padding:38px 32px 28px}.title{color:#f5f4ed;font-size:38px;font-weight:bold;text-align:center;margin-bottom:15px}.card,.draft{width:100%;flex-direction:column;background-color:#1d231f;border-radius:24px;padding:18px;margin-bottom:14px}.transcript{border-width:2px;border-color:#f28a32}.card-title,.label{color:#f5f4ed;font-size:22px;font-weight:bold;margin-bottom:9px}.meal-types{width:100%;justify-content:space-between}.chip{width:87px;height:48px;border-radius:24px;background-color:#303933;color:#cbd2cc;font-size:18px}.active{background-color:#f28a32;color:#17120e}.empty,.notice{color:#aeb8b1;font-size:18px;line-height:26px}.notice{color:#ffc18a;margin-bottom:10px}.food-row{width:100%;min-height:54px;align-items:center;justify-content:space-between;border-top-width:1px;border-color:#39423c}.food-name,.result{color:#f5f4ed;font-size:18px}.add{color:#ff9d45;font-size:16px}.picker{width:100%;height:54px;color:#f5f4ed;font-size:20px}.text-input{width:100%;height:58px;border-radius:16px;background-color:#303933;color:#f5f4ed;font-size:19px;padding:0 14px}.example,.parse,.ignore{width:100%;height:52px;border-radius:26px;background-color:#334039;color:#f5f4ed;font-size:18px;margin-top:9px}.parse,.ignore{background-color:#f28a32;color:#17120e}.parsed-result{width:100%;flex-direction:column}.source-text{width:100%;color:#f5f4ed;font-size:18px;line-height:26px;margin-bottom:9px}.edit-text{margin-top:0;margin-bottom:12px}.parsed-line{width:100%;line-height:26px;margin-bottom:6px}.unknown{margin-top:12px}.warn{color:#ffc18a;font-size:17px;line-height:24px}.draft{background-color:#19241e}.primary{width:100%;height:64px;border-radius:32px;background-color:#79d69a;color:#102016;font-size:22px;font-weight:bold}.bottom-space{height:40px}
</style>
