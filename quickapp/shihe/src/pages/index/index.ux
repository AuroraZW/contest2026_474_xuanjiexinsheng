<template>
  <div class="page">
    <text class="brand">食衡</text>
    <text class="loading">正在读取本机设置…</text>
  </div>
</template>

<script>
import router from '@system.router'
import { loadState } from '../../common/state-store'

export default {
  data: { started: false, navigated: false },
  onInit() {
    if (this.started) return
    this.started = true
    loadState(result => {
      if (this.navigated) return
      this.navigated = true
      if (result.status === 'ok' && result.state.profile) {
        router.replace({ uri: '/pages/home' })
        return
      }
      router.replace({
        uri: '/pages/onboarding',
        params: { storageStatus: result.status }
      })
    })
  }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #101311; flex-direction: column; align-items: center; justify-content: center; }
.brand { color: #ff9d45; font-size: 52px; font-weight: bold; }
.loading { color: #aeb8b1; font-size: 22px; margin-top: 20px; }
</style>
